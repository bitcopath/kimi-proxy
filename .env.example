# =============================================================================
# Kimi Proxy — copy this file to .env and fill in your own values.
# =============================================================================

# Host port on your Docker server where the proxy will be reachable.
# Pick any free port. If something else already uses 8083, choose 8084, 9001, etc.
SERVER_PORT=8083

# Path on the Docker HOST where Kimi Code stores its login/auth and config.
# Inside the container this is mounted to /root/.kimi-code.
# How to find yours:
#   - Linux/WSL:   /home/YOUR_USERNAME/.kimi-code
#   - macOS:       /Users/YOUR_USERNAME/.kimi-code
#   - Windows:     C:\Users\YOUR_USERNAME\.kimi-code  (use WSL or Docker Desktop path)
HOST_KIMI_CODE_PATH=/home/YOUR_USERNAME/.kimi-code

# Optional: legacy kimi-cli home. Only set this if you are migrating from the
# old pip-installed kimi-cli and want auth/config copied once.
# HOST_KIMI_LEGACY_PATH=/home/YOUR_USERNAME/.kimi

# Timeout for one Kimi CLI call in milliseconds (5 minutes default).
KIMI_TIMEOUT_MS=300000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SECURITY: only set this to true while troubleshooting.
# When true, full prompts and AI responses are written to the log file.
LOG_SENSITIVE=false
